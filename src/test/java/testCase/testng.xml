
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OpenCartSuite" thread-count="2" parallel="tests">

    <test name="ChromeTest">
        <parameter name="OS" value="Windows"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testCase.Tc001accountRegistrationPage"/>
             <class name="testCase.TC002LoginTest"/>
             <class name="testCase.TC003Datadriven_LoginPage"/>
        </classes>
    </test>

    <test name="EdgeTest">
        <parameter name="OS" value="Windows"/>
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="testCase.Tc001accountRegistrationPage"/>
            <class name="testCase.TC002LoginTest"/>
            <class name="testCase.TC003Datadriven_LoginPage"/>
        </classes>
    </test>

</suite>



